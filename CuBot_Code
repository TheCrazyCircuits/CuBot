unsigned long nextBlink = 0;
float blinkProgress = 0;

// Petting animation
bool isPetting = false;
float petProgress = 0;  // 0 = open, 1 = closed

// --- GOD-TIER BOOT SCREEN ---
void drawSplashScreen() {
  // 1. Initial "System Wake" Flicker
  for(int i=0; i<3; i++) {
    display.clearDisplay();
    display.drawFastHLine(0, random(0, 64), 128, SSD1306_WHITE); // Glitch line
    display.display();
    delay(random(10, 50));
  }

  // 2. Iris Expansion Animation
  for (float i = 0; i <= 1.0; i += 0.04) {
    display.clearDisplay();
    
    // Draw expanding orbital rings
    int radius = i * 25;
    display.drawCircle(64, 32, radius, SSD1306_WHITE);
    display.drawCircle(64, 32, radius - 2, SSD1306_WHITE);
    
    // Draw spinning "data" shards around the core
    float angle = i * 6.28;
    int x1 = 64 + cos(angle) * (radius + 5);
    int y1 = 32 + sin(angle) * (radius + 5);
    int x2 = 64 + cos(angle + 3.14) * (radius + 5);
    int y2 = 32 + sin(angle + 3.14) * (radius + 5);
    display.drawLine(x1, y1, x1 + (cos(angle)*5), y1 + (sin(angle)*5), SSD1306_WHITE);
    display.drawLine(x2, y2, x2 + (cos(angle+3.14)*5), y2 + (sin(angle+3.14)*5), SSD1306_WHITE);

    display.display();
  }

  // 3. Name Reveal with "Scanner" line
  for (int x = 0; x < 128; x += 8) {
    display.clearDisplay();
    // Background Text (Shadow) - Name changed to CuBot
    display.setTextSize(2);
    display.setTextColor(SSD1306_WHITE);
    display.setCursor(35, 24);
    display.print("CuBot");
    
    // Scanline effect
    display.fillRect(x, 0, 2, 64, SSD1306_WHITE);
    display.drawFastVLine(x-4, 10, 44, SSD1306_WHITE);
    
    display.display();
    delay(20);
  }

  // 4. Final Pulse
  for(int p=0; p<2; p++) {
    display.clearDisplay();
    display.setTextSize(2);
    display.setCursor(35, 24);
    display.print("CuBot");
    display.drawRoundRect(30, 20, 68, 24, 4, SSD1306_WHITE);
    display.display();
    delay(200);
    display.invertDisplay(true);
    delay(50);
    display.invertDisplay(false);
    delay(100);
  }

  delay(600);
  display.clearDisplay();
}

void drawEyes(float xOffset, float yOffset, float openness, bool isPetting) {
  int cx1 = 34 + xOffset;
  int cx2 = 94 + xOffset;
  int cy  = 32 + yOffset;

  int eyeWidth = 36;

  // =========================
  // 👉 PETTING MODE (SMOOTH MORPH)
  // =========================
if (isPetting) {
  float curveFactor = 1.0 - openness;

  // 👉 Phase 1: Normal eyes until half closed
  if (openness > 0.5) {
    int eyeHeight = max(3, (int)(36 * openness));
    int yTop = cy - eyeHeight / 2;

    display.fillRoundRect(cx1 - 18, yTop, eyeWidth, eyeHeight, 12, SSD1306_WHITE);
    display.fillRoundRect(cx2 - 18, yTop, eyeWidth, eyeHeight, 12, SSD1306_WHITE);
  }
  // 👉 Phase 2: Curved eyes after halfway
  else {
    int thickness = 2 + (curveFactor * 2); // keeps it nicely thick

    // Left eye
    for (int i = 0; i < thickness; i++) {
      display.drawLine(
        cx1 - 16,
        cy + 4 + i,
        cx1 + 16,
        cy + 6 + i,
        SSD1306_WHITE
      );
    }

    // Right eye
    for (int i = 0; i < thickness; i++) {
      display.drawLine(
        cx2 - 16,
        cy + 6 + i,
        cx2 + 16,
        cy + 4 + i,
        SSD1306_WHITE
      );
    }
  }

  return; // stop normal rendering
}

  // =========================
  // 👉 NORMAL MODE (BLINK/SLEEP)
  // =========================
  int eyeHeight = max(5, (int)(36 * openness));
  int yTop = cy - eyeHeight / 2;

  display.fillRoundRect(cx1 - 18, yTop, eyeWidth, eyeHeight, 12, SSD1306_WHITE);
  display.fillRoundRect(cx2 - 18, yTop, eyeWidth, eyeHeight, 12, SSD1306_WHITE);
}

void drawBlush(float xOffset, float yOffset) {
  int cx1 = 34 + xOffset;
  int cx2 = 94 + xOffset;
  int cy  = 32 + yOffset;

  int blushY = cy + 16; // slightly tighter to eyes

  // LEFT blush (short - long - short, diagonal)
  display.drawLine(cx1 - 10, blushY,     cx1 - 7, blushY + 2, SSD1306_WHITE); // short
  display.drawLine(cx1 - 12, blushY + 3, cx1 - 4, blushY + 7, SSD1306_WHITE); // long
  display.drawLine(cx1 - 10, blushY + 8, cx1 - 7, blushY +10, SSD1306_WHITE); // short

  // RIGHT blush (mirrored)
  display.drawLine(cx2 + 7, blushY + 2,  cx2 +10, blushY, SSD1306_WHITE);     // short
  display.drawLine(cx2 + 4, blushY + 7,  cx2 +12, blushY + 3, SSD1306_WHITE); // long
  display.drawLine(cx2 + 7, blushY +10,  cx2 +10, blushY + 8, SSD1306_WHITE); // short
}

void drawZzz(float baseX, float baseY) {
  display.setTextSize(1);
  display.setTextColor(SSD1306_WHITE);
  display.setCursor(baseX, baseY);
  display.print("Z");
  display.setCursor(baseX + 6, baseY - 6);
  display.print("z");
  display.setCursor(baseX + 12, baseY - 12);
  display.print("z");
}

void fetchWeather() {
  if (WiFi.status() != WL_CONNECTED) return;

  HTTPClient http;
  String apiKey = "YOUR_WEATHER_API_KEY";
  String url = "http://api.openweathermap.org/data/2.5/weather?q=Pune,IN&units=metric&appid=" + apiKey;

  http.begin(url);
  if (http.GET() > 0) {
    DynamicJsonDocument doc(2048);
    deserializeJson(doc, http.getString());

    temp = doc["main"]["temp"];
    feelsLike = doc["main"]["feels_like"];
    humidity = doc["main"]["humidity"];
    weatherDesc = doc["weather"][0]["main"].as<String>();
    cityName = doc["name"].as<String>();
  }
  http.end();
}

void drawWeather() {
  display.drawRect(0, 0, 128, 64, SSD1306_WHITE);

  display.setTextSize(1);
  display.setCursor(5, 4);
  display.print(cityName);
  display.drawLine(4, 13, 123, 13, SSD1306_WHITE);

  display.setTextSize(4);
  display.setCursor(12, 18);
  display.print((int)temp);

  display.setTextSize(1);
  display.setCursor(68, 18);
  display.print("o");

  display.setTextSize(2);
  display.setCursor(78, 22);
  display.print("C");

  display.setTextSize(1);
  display.setCursor(78, 40);
  display.print("Feels");
  display.setCursor(78, 49);
  display.print((int)feelsLike);

  display.setCursor(5, 49);
  display.print(weatherDesc);

  display.setCursor(100, 49);
  display.print(humidity);
  display.print("%");
}

void setup() {
  WiFi.begin(ssid, password);
  while (WiFi.status() != WL_CONNECTED) delay(500);

  configTime(19800, 0, "pool.ntp.org");
  Wire.begin();
  pinMode(TOUCH_PIN, INPUT);
  mpu.initialize();
  display.begin(0x3C, true); // 0x3C is the typical I2C address
  display.clearDisplay();
  display.display();
  
  // --- Start God-Tier Boot Screen ---
  drawSplashScreen(); 

  randomSeed(analogRead(0));
  lastTime = millis();
  nextBlink = millis() + random(3000, 6000);
}

void loop() {
  mpu.getAcceleration(&ax, &ay, &az);
  bool touchState = digitalRead(TOUCH_PIN);
  int shakeStrength = abs(ax) + abs(ay) + abs(az);
  if (shakeStrength > 40000 && !isShaking) {
    isShaking = true;
    shakeStart = millis();
  }

if (touchState || isShaking) {
  lastInteraction = millis();
  isSleeping = false;

  // EXIT WEATHER MODE
  if (showWeather && (isShaking || tapCount == 1)) {
    showWeather = false;
  }
}
  
  if (millis() - lastInteraction > 20000) {
    if (!isSleeping) {
    sleepStartTime = millis(); // mark sleep start
  }
    isSleeping = true;
  } else {
    isSleeping = false;
    showClock = false; // wake = hide clock
  }

  if (isSleeping && (millis() - sleepStartTime > 10000)) {
  showClock = true;
  }
  
  float targetSleep = isSleeping ? 1.0 : 0.0;
  sleepProgress += (targetSleep - sleepProgress) * 0.02;

  unsigned long now = millis();
  float dt = (now - lastTime) / 1000.0;
  lastTime = now;
  t += dt;

  if (!isSleeping) {
    // Applied the wobbling effect here as requested previously
    offsetX = (sin(t * 0.8) * 4) + (cos(t * 1.5) * 2);
    offsetY = (sin(t * 0.6) * 3) + (sin(t * 1.2) * 1.5);
  } else {
    offsetX = sin(t * 0.2) * 2;
    offsetY = sin(t * 0.15) * 1;
  }

if (touchState && !lastTouchState) {
  petStartTime = millis(); // when touch begins
}

// delay before petting activates
if (touchState && millis() - petStartTime > 150) {
  isPetting = true;
} else {
  isPetting = false;
}

// --- TAP DETECTION (EDGE BASED) ---
if (touchState && !lastTouchState) {  // ONLY when touch starts

  if (millis() - lastTapTime < tapGap) {
    tapCount++;
  } else {
    tapCount = 1;
  }

  lastTapTime = millis();

  if (tapCount == 3) {
    showWeather = true;
    fetchWeather();
    tapCount = 0;
  }
}

  float targetPet = isPetting ? 1.0 : 0.0;
  petProgress += (targetPet - petProgress) * 0.08;

  if (!isPetting) {
    if (!isBlinking && now > nextBlink) {
      isBlinking = true;
      blinkStart = now;
    }

    if (isBlinking) {
      float elapsed = (now - blinkStart) / 350.0;
      if (elapsed < 0.5) {
        blinkProgress = elapsed * 2;
      } else if (elapsed < 1.0) {
        blinkProgress = (1.0 - elapsed) * 2;
      } else {
        blinkProgress = 0;
        isBlinking = false;
        // --- FREQUENT BLINK ADJUSTMENT ---
        // Changed from (3000, 7000) to (500, 3000) for a more active look
        nextBlink = now + random(500, 3000); 
      }
    }
  }

  float openness;
  float sleepOpen = 1.0 - (sleepProgress * 0.6);

  if (isPetting) {
    openness = 1.0 - petProgress;
  } else if (!isSleeping) {
    openness = 1.0 - blinkProgress;
  } else {
    openness = sleepOpen;
  }

  if (isShaking) {
    float elapsed = (millis() - shakeStart) / 1000.0;
    if (elapsed < 1.0) {
      shakeOffsetX = sin(elapsed * 25) * 12;
      shakeOffsetY = cos(elapsed * 25) * 6;
    } else if (elapsed < 4.0) {
      shakeOffsetX = sin(elapsed * 5) * 5;
      shakeOffsetY = sin(elapsed * 3) * 3;
    } else if (elapsed < 5.0) {
      float fade = (5.0 - elapsed);
      shakeOffsetX = sin(elapsed * 4) * 5 * fade;
      shakeOffsetY = sin(elapsed * 3) * 3 * fade;
    } else {
      isShaking = false;
      shakeOffsetX = 0;
      shakeOffsetY = 0;
    }
  } else {
    shakeOffsetX = 0;
    shakeOffsetY = 0;
  }

  if (showWeather && millis() - lastWeatherFetch > 600000) {
  fetchWeather();
  lastWeatherFetch = millis();
}

display.clearDisplay();

if (showWeather) {
  drawWeather();
}
else if (showClock) {
  // ===== CLOCK MODE =====
  struct tm timeinfo;
  if (getLocalTime(&timeinfo)) {

    display.setTextColor(SSD1306_WHITE);

    display.drawRect(0, 0, 128, 64, SSD1306_WHITE);

    display.setTextSize(3);
    display.setCursor(20, 14);
    display.printf("%02d:%02d", timeinfo.tm_hour, timeinfo.tm_min);

    display.drawFastHLine(25, 42, 78, SSD1306_WHITE);

    display.setTextSize(1);

    char dayName[4];
    strftime(dayName, 4, "%a", &timeinfo);
    for(int i=0; i<3; i++) dayName[i] = toupper(dayName[i]);

    char fullDate[20];
    sprintf(fullDate, "%s  %02d.%02d.%04d",
      dayName,
      timeinfo.tm_mday,
      timeinfo.tm_mon + 1,
      timeinfo.tm_year + 1900
    );

    display.setCursor(19, 49);
    display.print(fullDate);
  }

} else {
  // ===== FACE MODE =====

  drawEyes(offsetX + shakeOffsetX, offsetY + shakeOffsetY, openness, isPetting);

  if (isPetting && petProgress > 0.55) {
    drawBlush(offsetX + shakeOffsetX, offsetY + shakeOffsetY);
  }

  if (isSleeping) {
    zzzY += 0.3;
    if (zzzY > 20) zzzY = 0;

    float zzzAlpha = sin((zzzY / 20.0) * PI);
    int baseX = 90;
    int baseY = 30 - zzzY;

    display.setTextSize(1);

    if (zzzAlpha > 0.2) { display.setCursor(baseX, baseY); display.print("Z"); }
    if (zzzAlpha > 0.4) { display.setCursor(baseX + 6, baseY - 6); display.print("z"); }
    if (zzzAlpha > 0.6) { display.setCursor(baseX + 12, baseY - 12); display.print("z"); }
  }
}

display.display();

lastTouchState = touchState;

}
